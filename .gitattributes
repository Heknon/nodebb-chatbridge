# Keep shell scripts LF so they run under WSL/Linux/macOS even when the repo is
# checked out on Windows (Git-for-Windows autocrlf would otherwise add CRLF and
# break the `#!/usr/bin/env bash` shebang).
*.sh   text eol=lf
*.bash text eol=lf

# Windows-native scripts stay CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Everything else: normalize to LF in the repo.
* text=auto eol=lf
